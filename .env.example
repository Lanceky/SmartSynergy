# Copy to .env and fill in. Never commit .env. Placeholders only in this file.

# --- AWS / Amazon Bedrock ---
AWS_REGION=us-west-2
# Optional named profile from ~/.aws/credentials; leave empty to use the default credential chain.
AWS_PROFILE=
# Strands default model. Any Bedrock model with tool-use support that you have enabled in AWS_REGION works.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Storage ---
SMARTSYNERGY_DB=./data/smartsynergy.db

# --- Source mode: live (Europe PMC / PubChem over HTTP) or replay (fixtures/snapshots) ---
SMARTSYNERGY_SOURCE_MODE=live

# --- Per-run budgets (enforced in code, not just prompts) ---
SMARTSYNERGY_MAX_PAPERS_PER_RUN=30
SMARTSYNERGY_MAX_MODEL_CALLS_PER_RUN=12
SMARTSYNERGY_MAX_TOOL_CALLS_PER_RUN=40
SMARTSYNERGY_RUN_TIMEOUT_S=300
SMARTSYNERGY_NODE_TIMEOUT_S=120

# --- Daily hard stop for scheduled runs (cost control) ---
SMARTSYNERGY_MAX_RUNS_PER_DAY=6

# --- Sent in the User-Agent header to public APIs (Europe PMC, PubChem) ---
CONTACT_EMAIL=you@example.com

# --- Hosted demo: disables "Check now" and isolates decisions for anonymous visitors ---
DEMO_READ_ONLY=false
